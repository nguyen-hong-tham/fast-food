        <mxCell id="order-flow" value="📋 ORDER FLOW:&#xa;1. Customer creates order (Mobile)&#xa;2. Backend processes payment (VNPay)&#xa;3. Restaurant receives notification&#xa;4. Restaurant prepares order&#xa;5. Drone assigned for delivery&#xa;6. Real-time tracking (60-sec simulation)&#xa;7. Order completed + review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#CC9900;fontSize=11;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1080" y="120" width="280" height="200" as="geometry" />
        </mxCell>
        <mxCell id="tech-stack" value="🛠️ TECH STACK:&#xa;• Mobile: React Native + Expo&#xa;• Restaurant: Next.js 14 + React 18&#xa;• Admin: React 18 + Vite 6&#xa;• Backend: Appwrite Cloud&#xa;• Payment: VNPay Gateway&#xa;• Maps: Mapbox / Google Maps&#xa;• Notifications: FCM&#xa;• State: Zustand&#xa;• Styling: TailwindCSS + NativeWind&#xa;• Language: TypeScript 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#0066CC;fontSize=11;align=left;verticalAlign=top;" parent="1" vertex="1">
          <mxGeometry x="1080" y="340" width="280" height="240" as="geometry" />
