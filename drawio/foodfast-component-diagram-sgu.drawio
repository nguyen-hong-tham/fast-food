        <mxCell id="legend-box" value="LEGEND" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#333333;fontSize=12;fontStyle=1;verticalAlign=top;align=center;" vertex="1" parent="1">
          <mxGeometry x="1480" y="680" width="280" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="legend-content" value="&#xa;━━━  Synchronous API Call (REST)&#xa;┅┅┅  Realtime Connection (WebSocket)&#xa;┄┄┄  External Service Integration&#xa;⬌  Bidirectional Communication&#xa;&#xa;🟨  Screens / Pages (UI Layer)&#xa;🟪  Components &amp; Stores (State)&#xa;🟦  Backend Services (Appwrite)&#xa;🟩  External Services (VNPay, Maps, FCM)&#xa;🟧  Database Collections&#xa;&#xa;Stereotypes:&#xa;&amp;lt;&amp;lt;Screen&amp;gt;&amp;gt; - Mobile screens&#xa;&amp;lt;&amp;lt;Page&amp;gt;&amp;gt; - Web pages&#xa;&amp;lt;&amp;lt;Component&amp;gt;&amp;gt; - Reusable UI components&#xa;&amp;lt;&amp;lt;Store&amp;gt;&amp;gt; - State management (Zustand)&#xa;&amp;lt;&amp;lt;Service&amp;gt;&amp;gt; - API client functions" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;fontFamily=Courier New;" vertex="1" parent="1">
          <mxGeometry x="1495" y="710" width="250" height="160" as="geometry" />
        </mxCell>

        <!-- Footer -->
        <mxCell id="footer" value="FoodFast Platform | Component Diagram (SGU Format) | Generated: October 2025 | Technology: React Native + Next.js + React + Appwrite" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="510" y="1350" width="900" height="20" as="geometry" />
        </mxCell>

        <!-- Architecture Note -->
        <mxCell id="arch-note" value="🏗️ Architecture Pattern: Multi-Platform BaaS (Backend as a Service)&#xa;• Customer Mobile App: React Native (Expo) for iOS/Android&#xa;• Restaurant Portal: Next.js (Server Components) for Web&#xa;• Admin Dashboard: React (Vite) for Web&#xa;• Backend: Appwrite Cloud (Auth, DB, Storage, Realtime, Functions)&#xa;• State: Zustand (lightweight state management)&#xa;• Real-time: WebSocket subscriptions for live updates&#xa;• Payments: VNPay integration with webhooks&#xa;• Maps: Google Maps / Mapbox for drone tracking&#xa;• Notifications: Firebase Cloud Messaging (FCM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF9E6;strokeColor=#CC9900;fontSize=10;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="1000" width="920" height="120" as="geometry" />
        </mxCell>

        <!-- Key Flows Note -->
        <mxCell id="flows-note" value="🔄 Key Data Flows:&#xa;1. Customer Orders: Mobile App → Appwrite API → Database → VNPay Payment → Order Confirmed&#xa;2. Real-time Tracking: Drone Service → Appwrite Realtime → WebSocket → Mobile App Map Updates&#xa;3. Restaurant Orders: New Order Event → Appwrite Realtime → Restaurant Portal → Sound Notification&#xa;4. Admin Simulation: Start Simulation → Cloud Function (60-sec loop) → Broadcast Location → All Subscribers&#xa;5. Push Notifications: Order Event → Cloud Function → FCM → Mobile Device" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3FF;strokeColor=#0066CC;fontSize=10;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="1160" y="1000" width="600" height="120" as="geometry" />
        </mxCell>

        <!-- Technology Stack -->
        <mxCell id="tech-stack-note" value="⚙️ Technology Stack Details:&#xa;• Mobile: React Native 0.81.4 + Expo 54 + NativeWind 4.2 + Zustand 5.0&#xa;• Restaurant Web: Next.js 14.0.4 + TailwindCSS 3.4 + Recharts 2.10 + React Hook Form 7.49&#xa;• Admin Web: React 18.3 + Vite 6.0 + TailwindCSS 3.4 + Recharts 2.15 + Lucide Icons 0.468&#xa;• Backend: Appwrite Cloud (Auth, Database, Storage, Realtime, Functions)&#xa;• Database: 16 Collections (users, restaurants, menu_items, orders, drones, etc.)&#xa;• Language: TypeScript 5.7 (100% type coverage)&#xa;• Maps: Google Maps JavaScript API + Mapbox GL JS&#xa;• Payment: VNPay Gateway (Vietnamese standard)&#xa;• Notifications: Firebase Cloud Messaging (FCM)&#xa;• Monitoring: Sentry (errors) + Firebase Analytics (metrics)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E6FF;strokeColor=#9933CC;fontSize=9;align=left;verticalAlign=top;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="200" y="1150" width="1560" height="120" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
