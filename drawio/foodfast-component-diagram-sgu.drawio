        <mxCell id="appwrite-features" value="🔐 Authentication&#xa;  • Email/Password&#xa;  • Sessions &amp; JWT&#xa;  • Role-based access&#xa;&#xa;💾 Database (16 Collections)&#xa;  • users, restaurants, menu_items&#xa;  • orders, order_items, payments&#xa;  • drones, drone_events, reviews&#xa;&#xa;📦 Storage &amp; CDN&#xa;  • Image uploads&#xa;  • File optimization&#xa;&#xa;⚡ Realtime (WebSocket)&#xa;  • Order updates&#xa;  • Drone tracking" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="210" y="710" width="260" height="160" as="geometry" />
        </mxCell>

        <!-- Cloud Functions -->
        <mxCell id="cloud-functions" value="&amp;lt;&amp;lt;Backend Service&amp;gt;&amp;gt;&#xa;Appwrite Functions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="520" y="680" width="200" height="200" as="geometry" />
        </mxCell>
        
        <mxCell id="functions-list" value="⚙️ Cloud Functions:&#xa;&#xa;• handleVNPayWebhook()&#xa;  - Verify signature&#xa;  - Update payment status&#xa;  - Send notifications&#xa;&#xa;• startDroneSimulation()&#xa;  - 60-second loop&#xa;  - Update location&#xa;  - Broadcast events&#xa;&#xa;• sendEmailNotification()&#xa;  - Order confirmed&#xa;  - Restaurant approved&#xa;&#xa;• aggregateDailyStats()&#xa;  - Revenue calculations&#xa;  - Reports generation" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=9;" vertex="1" parent="1">
          <mxGeometry x="530" y="710" width="180" height="160" as="geometry" />
        </mxCell>

