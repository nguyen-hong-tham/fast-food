          <mxGeometry x="200" y="100" width="500" height="160" as="geometry" />
        </mxCell>
        <mxCell id="notes-content" value="1. Separate tables per role = better organization&#xa;&#xa;2. All profile tables link to Appwrite Auth via accountId&#xa;   • Appwrite handles authentication&#xa;   • Profile tables store role-specific data&#xa;&#xa;3. Relationships updated:&#xa;   • restaurants.ownerId → RestaurantOwners.$id&#xa;   • orders.customerId → Customers.$id&#xa;&#xa;4. Admin permissions are granular &amp; explicit" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11" vertex="1" parent="1">
