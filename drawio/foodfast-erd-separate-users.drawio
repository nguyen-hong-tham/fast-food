          <mxGeometry x="1420" y="750" width="400" height="270" as="geometry" />
        </mxCell>
        <mxCell id="legend-content" value="✓ = Required field&#xa;⚡ = Links to Appwrite Auth&#xa;🔗 = Foreign key relationship&#xa;PK = Primary Key&#xa;FK = Foreign Key&#xa;&#xa;🎨 Color Coding:&#xa;• Blue = Customers (end users)&#xa;• Green = Restaurant Owners (business)&#xa;• Pink = Admins (system management)&#xa;• Purple = Restaurants (business entity)&#xa;• Yellow = Orders &amp; Transactions&#xa;&#xa;📊 Benefits:&#xa;• Better security &amp; permissions&#xa;• Faster queries (smaller tables)&#xa;• Easier to scale per role&#xa;• Cleaner code structure" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="1440" y="780" width="360" height="230" as="geometry" />
