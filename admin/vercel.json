{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "VITE_APPWRITE_ENDPOINT": "@vite_appwrite_endpoint",
    "VITE_APPWRITE_PROJECT_ID": "@vite_appwrite_project_id",
    "VITE_APPWRITE_DATABASE_ID": "@vite_appwrite_database_id",
    "VITE_APPWRITE_BUCKET_ID": "@vite_appwrite_bucket_id",
    "VITE_APPWRITE_USER_COLLECTION_ID": "@vite_appwrite_user_collection_id",
    "VITE_APPWRITE_ORDERS_COLLECTION_ID": "@vite_appwrite_orders_collection_id",
    "VITE_APPWRITE_MENU_COLLECTION_ID": "@vite_appwrite_menu_collection_id",
    "VITE_APPWRITE_CATEGORIES_COLLECTION_ID": "@vite_appwrite_categories_collection_id",
    "VITE_APPWRITE_CUSTOMIZATIONS_COLLECTION_ID": "@vite_appwrite_customizations_collection_id",
    "VITE_APPWRITE_MENU_CUSTOMIZATIONS_COLLECTION_ID": "@vite_appwrite_menu_customizations_collection_id"
  }
}
