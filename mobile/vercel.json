{
  "buildCommand": "npm install && npm run build && echo 'Build successful, checking dist:' && ls -la dist/ || echo 'Checking dist folder'",
  "outputDirectory": "dist",
  "github": {
    "enabled": true,
    "autoAlias": false,
    "autoJobCancelation": true
  },
  "env": {
    "EXPO_PUBLIC_APPWRITE_ENDPOINT": "@expo_public_appwrite_endpoint",
    "EXPO_PUBLIC_APPWRITE_PROJECT_ID": "@expo_public_appwrite_project_id",
    "EXPO_PUBLIC_APPWRITE_DATABASE_ID": "@expo_public_appwrite_database_id",
    "EXPO_PUBLIC_APPWRITE_BUCKET_ID": "@expo_public_appwrite_bucket_id"
  }
}
